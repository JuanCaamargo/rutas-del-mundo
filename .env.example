# Copia este archivo como ".env" y completa los valores.
# Si GEMINI_API_KEY queda vacía, el sistema usa el generador simulado (sin IA real).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Costo base de hospedaje por noche y por persona, en USD (supuesto hasta implementar HU-04).
RDM_TARIFA_NOCHE=90
RDM_SECRET=
# Desarrollo local usa SQLite; Render define RDM_DB_MODE=postgres.
RDM_DB_MODE=sqlite
# Solo necesario cuando RDM_DB_MODE=postgres; guárdalo como variable secreta en Render.
DATABASE_URL=
# Cambia las contraseñas de demostración al desplegar.
RDM_ADMIN_PASSWORD=
RDM_ADVISOR_PASSWORD=